	"item": [
		{
			"name": "Encode",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const testcase = pm.iterationData.toObject()\r",
							"if (Object.keys(testcase).length !== 0) {\r",
							"    pm.test(\"status code matches testcase.statusCode\",\r",
							"        function () {\r",
							"            pm.expect(pm.response.code).to.equals(testcase.expectedStatusCode)\r",
							"        }\r",
							"    )\r",
							"\r",
							"    pm.test(\"shortenUrl has path match testcase.shortenId\",\r",
							"        function () {\r",
							"            if (pm.response.code === 200) {\r",
							"                const path = pm.response.json().shortenUrl.\r",
							"                    replace(`${pm.collectionVariables.get(\"PUBLIC_DOMAIN\")}/`, \"\")\r",
							"                pm.expect(path).to.equals(testcase.expectedShortenId)\r",
							"            }\r",
							"        }\r",
							"    )\r",
							"    const path = pm.response.json().shortenUrl.\r",
							"        replace(`${pm.collectionVariables.get(\"PUBLIC_DOMAIN\")}/`, \"\")\r",
							"    pm.collectionVariables.set(\"nextDecodeRequest\", {\r",
							"        url: `${pm.collectionVariables.get(\"DOMAIN\")}/${path}`\r",
							"    })\r",
							"}\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const testcase = pm.iterationData.toObject();\r",
							"if (Object.keys(testcase).length !== 0) {\r",
							"    pm.request.body.raw = JSON.stringify({\r",
							"        url: testcase.url\r",
							"    })\r",
							"    postman.setNextRequest(\"Decode\")\r",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
